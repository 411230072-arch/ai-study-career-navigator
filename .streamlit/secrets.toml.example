# .streamlit/secrets.toml.example
# -------------------------------------------------------------
# Instructions for local setup:
# 1. Duplicate this file and rename the copy to: secrets.toml
#    (Path: .streamlit/secrets.toml)
# 2. Replace the placeholder value below with your Google Gemini API key.
#    Get a free API key at: https://aistudio.google.com/
# 3. Never commit secrets.toml to Git! (.gitignore already excludes it)
# 4. If no API key is provided, the application will automatically run
#    in offline Local Career Guidance mode.
# -------------------------------------------------------------

GEMINI_API_KEY = "your-gemini-api-key-here"
